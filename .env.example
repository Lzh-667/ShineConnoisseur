# 复制为 .env 后再填写。不要提交 .env、私钥或证书文件。

# 端口映射
BACKEND_PORT=8080
FRONTEND_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
ES_PORT=9200
AGENT_PORT=8001

# 基础设施凭据（请替换为随机强密码）
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=shineconnoisseur
MYSQL_USER=shine_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
RABBITMQ_DEFAULT_USER=shine_app
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/shine

# 支付宝沙箱（留空时社区主体功能仍可启动，但支付接口不可用）
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 微信支付。私钥放到 secrets/wechat/apiclient_key.pem，切勿提交。
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat/apiclient_key.pem
WECHAT_MERCHANT_SERIAL_NUMBER=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=

# AI Agent（只有使用 --profile ai 启动时才需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_PRICE=0
DEEPSEEK_OUTPUT_PRICE=0
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
AGENT_REDIS_DB=0
AGENT_CHECKPOINT=sqlite
CHAT_RATE_LIMIT=10
AGENT_COOKIE_SECURE=false
ADMIN_TOOL_INVOKE_ENABLED=false

TZ=Asia/Shanghai
JAVA_OPTS=-Xms512m -Xmx512m
